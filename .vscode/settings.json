{
  "go.useLanguageServer": true,
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "package",
  "go.vetOnSave": "package",
  "go.formatTool": "goimports",
  "go.toolsManagement.autoUpdate": true,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[go]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": false,
    "editor.snippetSuggestions": "top",
    "editor.defaultFormatter": "golang.go"
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "files.exclude": {
    "**/bin": true,
    "**/data": true,
    "**/*.exe": true
  },
  "cSpell.language": "en,ru",
  "cSpell.words": [
    "НИС",
    "Стрибог",
    "эскроу",
    "Росвоенипотека",
    "Росреестр",
    "КриптоПро",
    "Кузнечик",
    "Минобороны",
    "Меркла",
    "GOST",
    "gos",
    "gost",
    "rosreestr",
    "hyperledger",
    "badgerdb",
    "badger",
    "healthz",
    "kadastr",
    "kadastrnum",
    "benchtime",
    "benchmem",
    "gopath",
    "gomodcache",
    "gocache",
    "goroot",
    "golangci",
    "goimports",
    "gopls",
    "dlv",
    "dap",
    "ruwireguard",
    "utxo",
    "mgm",
    "aead",
    "escrow",
    "nis",
    "clis",
    "cryptopro",
    "vipnet",
    "author",
    "lic",
    "libc",
    "stdout",
    "stderr",
    "stdin",
    "endian",
    "utils",
    "init",
    "repo",
    "runtime",
    "vm",
    "wsl",
    "powershell",
    "pwsh"
  ]
}
